{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:frontend": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --splitting --format=esm --outdir=dist",
    "start": "node scripts/start-production.mjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "test": "node scripts/run-tests.mjs",
    "test:browser": "npm run build && playwright test",
    "test:authorization:db": "node --import tsx --test tests/database/authorization.test.ts",
    "test:accounts": "node scripts/run-accounts-tests.mjs",
    "test:accounts:db": "node --import tsx --test tests/database/accounts.test.ts",
    "test:physical:db": "node --import tsx --test tests/database/physical-plans.test.ts",
    "test:physical": "node scripts/run-physical-tests.mjs",
    "test:journal": "playwright test --config playwright.journal.config.ts --reporter=line",
    "test:autosave": "node scripts/run-autosave-tests.mjs",
    "test:runtime": "node --test tests/runtime/start.test.mjs"
  },
