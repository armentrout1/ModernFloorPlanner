{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "npm run build:vercel",
  "routes": [
    { "src": "^/(?:quick-room|physical-draft|account/(?:confirm|reset-password))?$", "methods": ["GET", "HEAD"], "dest": "/index.html" },
    { "src": "^/(?:quick-room|physical-draft|account/(?:confirm|reset-password))?$", "status": 405, "headers": { "Allow": "GET, HEAD" } }
  ]
}
