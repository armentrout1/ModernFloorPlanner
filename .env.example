# Browser-visible Supabase configuration. Never place a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only PostgreSQL configuration. DATABASE_URL must remain secret.
DATABASE_URL=
MFP_DATABASE_CONNECTION_MODE=transaction
MFP_DATABASE_APP_MAX=1
MFP_DATABASE_SESSION_MAX=1
# Optional PEM certificate override when the platform trust store is insufficient.
# MFP_DATABASE_CA_CERT=

# Server-only OIDC and session configuration.
MFP_OIDC_ISSUER=
MFP_OIDC_CLIENT_ID=
MFP_OIDC_CLIENT_AUTH_METHOD=client_secret_basic
MFP_OIDC_CLIENT_SECRET=
MFP_APP_ORIGIN=
MFP_OIDC_CALLBACK_URI=
MFP_SESSION_SECRET=
