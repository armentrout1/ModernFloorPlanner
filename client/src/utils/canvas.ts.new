import { Position, Room, Size, WallSide, ObjectType, RoomObject } from './types';

export const GRID_SIZE = 20; // pixels
export const ROOM_MIN_SIZE = 60; // pixels
export const SCALE_FACTOR = 1.2;
export const FEET_PER_GRID = 1; // 1 grid = 1 foot

// Snap a coordinate to the grid
export function snapToGrid(value: number): number {
  return Math.round(value / GRID_SIZE) * GRID_SIZE;
}

// Convert pixels to feet
export function pixelsToFeet(pixels: number): number {
  return (pixels / GRID_SIZE) * FEET_PER_GRID;
}

// Convert feet to pixels
export function feetToPixels(feet: number): number {
  return (feet / FEET_PER_GRID) * GRID_SIZE;
}

// Convert a decimal feet value to feet and inches
export function feetToFeetAndInches(feet: number): string {
  const wholeFeet = Math.floor(feet);
  const inches = Math.round((feet - wholeFeet) * 12);
  
  if (inches === 12) {
    return `${wholeFeet + 1}'`;
  } else if (inches === 0) {
    return `${wholeFeet}'`;
  } else {
    return `${wholeFeet}' ${inches}"`;
  }
}

// Format dimensions as feet
export function formatDimensions(width: number, height: number): string {
  const widthInFeet = pixelsToFeet(width);
  const heightInFeet = pixelsToFeet(height);
  return `${feetToFeetAndInches(widthInFeet)} × ${feetToFeetAndInches(heightInFeet)}`;
}

// Calculate the area of a room in square feet
export function calculateRoomArea(room: Room): number {
  const widthFeet = pixelsToFeet(room.width);
  const heightFeet = pixelsToFeet(room.height);
  return widthFeet * heightFeet;
}

// Calculate the total area of all rooms
export function calculateTotalArea(rooms: Room[]): number {
  return rooms.reduce((total, room) => total + calculateRoomArea(room), 0);
}

// Format area value as square feet
export function formatArea(area: number): string {
  return `${Math.round(area)} sq ft`;
}

// Create a new room with default values
export function createRoom(
  x: number,
  y: number,
  width: number = ROOM_MIN_SIZE,
  height: number = ROOM_MIN_SIZE
): Room {
  return {
    id: generateId(),
    x: snapToGrid(x),
    y: snapToGrid(y),
    width: snapToGrid(Math.max(width, ROOM_MIN_SIZE)),
    height: snapToGrid(Math.max(height, ROOM_MIN_SIZE)),
    name: 'Room',
    color: '#93c5fd',
  };
}

// Generate a unique ID for a room
export function generateId(): string {
  return `room_${Date.now()}_${Math.floor(Math.random() * 1000)}`;
}

// Calculate the position of a resize handle
export function getResizeHandlePosition(
  room: Room,
  handle: string,
  scale: number = 1
): Position {
  const { x, y, width, height } = room;
  
  switch (handle) {
    case 'nw':
      return { x, y };
    case 'ne':
      return { x: x + width, y };
    case 'sw':
      return { x, y: y + height };
    case 'se':
      return { x: x + width, y: y + height };
    default:
      return { x: 0, y: 0 };
  }
}

// Calculate new room dimensions when resizing
export function getResizedRoom(
  room: Room,
  handle: string,
  newPos: Position
): Room {
  const { id, x, y, width, height, name, color } = room;
  const snappedX = snapToGrid(newPos.x);
  const snappedY = snapToGrid(newPos.y);
  
  let newRoom = { ...room };
  
  switch (handle) {
    case 'nw':
      newRoom = {
        ...room,
        x: snappedX,
        y: snappedY,
        width: Math.max(x + width - snappedX, ROOM_MIN_SIZE),
        height: Math.max(y + height - snappedY, ROOM_MIN_SIZE),
      };
      break;
    case 'ne':
      newRoom = {
        ...room,
        y: snappedY,
        width: Math.max(snappedX - x, ROOM_MIN_SIZE),
        height: Math.max(y + height - snappedY, ROOM_MIN_SIZE),
      };
      break;
    case 'sw':
      newRoom = {
        ...room,
        x: snappedX,
        width: Math.max(x + width - snappedX, ROOM_MIN_SIZE),
        height: Math.max(snappedY - y, ROOM_MIN_SIZE),
      };
      break;
    case 'se':
      newRoom = {
        ...room,
        width: Math.max(snappedX - x, ROOM_MIN_SIZE),
        height: Math.max(snappedY - y, ROOM_MIN_SIZE),
      };
      break;
  }
  
  return newRoom;
}

// Calculate the absolute position of a room object based on its wall side and percentage
export function calculateObjectPosition(
  room: Room,
  wallSide: WallSide,
  percentage: number
): Position {
  const { x, y, width, height } = room;
  
  switch (wallSide) {
    case 'top':
      return { x: x + (width * percentage / 100), y: y };
    case 'right':
      return { x: x + width, y: y + (height * percentage / 100) };
    case 'bottom':
      return { x: x + (width * percentage / 100), y: y + height };
    case 'left':
      return { x: x, y: y + (height * percentage / 100) };
    default:
      return { x: 0, y: 0 };
  }
}

// Get wall length based on wall side
export function getWallLength(room: Room, wallSide: WallSide): number {
  switch (wallSide) {
    case 'top':
    case 'bottom':
      return room.width;
    case 'left':
    case 'right':
      return room.height;
    default:
      return 0;
  }
}

// Create a new room object (door or window)
export function createRoomObject(
  type: ObjectType,
  wallSide: WallSide,
  position: number,
  size: number = 30
): RoomObject {
  return {
    id: `obj_${generateId()}`,
    type,
    wallSide,
    position,
    size
  };
}

// Determine which wall side and position was clicked
export function detectWallClick(
  room: Room,
  clickPosition: Position,
  threshold: number = 10
): { wallSide: WallSide; percentage: number } | null {
  const { x, y, width, height } = room;
  
  // Check top wall
  if (Math.abs(clickPosition.y - y) <= threshold && 
      clickPosition.x >= x && 
      clickPosition.x <= x + width) {
    return {
      wallSide: 'top',
      percentage: ((clickPosition.x - x) / width) * 100
    };
  }
  
  // Check right wall
  if (Math.abs(clickPosition.x - (x + width)) <= threshold && 
      clickPosition.y >= y && 
      clickPosition.y <= y + height) {
    return {
      wallSide: 'right',
      percentage: ((clickPosition.y - y) / height) * 100
    };
  }
  
  // Check bottom wall
  if (Math.abs(clickPosition.y - (y + height)) <= threshold && 
      clickPosition.x >= x && 
      clickPosition.x <= x + width) {
    return {
      wallSide: 'bottom',
      percentage: ((clickPosition.x - x) / width) * 100
    };
  }
  
  // Check left wall
  if (Math.abs(clickPosition.x - x) <= threshold && 
      clickPosition.y >= y && 
      clickPosition.y <= y + height) {
    return {
      wallSide: 'left',
      percentage: ((clickPosition.y - y) / height) * 100
    };
  }
  
  return null;
}

// Auto-align rooms by shared walls
export function autoAlignRooms(rooms: Room[]): Room[] {
  if (rooms.length <= 1) return rooms;
  
  const result = [...rooms];
  
  for (let i = 0; i < result.length; i++) {
    const roomA = result[i];
    
    for (let j = 0; j < result.length; j++) {
      if (i === j) continue;
      
      const roomB = result[j];
      const threshold = GRID_SIZE * 2; // 2 grid cells threshold for alignment
      
      // Check if rooms are close enough to align
      
      // Right edge of roomA close to left edge of roomB
      if (Math.abs((roomA.x + roomA.width) - roomB.x) < threshold) {
        // Check if they overlap vertically
        const verticalOverlap = 
          (roomA.y <= roomB.y + roomB.height && roomA.y >= roomB.y) ||
          (roomA.y + roomA.height >= roomB.y && roomA.y + roomA.height <= roomB.y + roomB.height) ||
          (roomA.y <= roomB.y && roomA.y + roomA.height >= roomB.y + roomB.height);
          
        if (verticalOverlap) {
          result[i] = {
            ...roomA,
            x: roomB.x - roomA.width
          };
        }
      }
      
      // Left edge of roomA close to right edge of roomB
      if (Math.abs(roomA.x - (roomB.x + roomB.width)) < threshold) {
        // Check if they overlap vertically
        const verticalOverlap = 
          (roomA.y <= roomB.y + roomB.height && roomA.y >= roomB.y) ||
          (roomA.y + roomA.height >= roomB.y && roomA.y + roomA.height <= roomB.y + roomB.height) ||
          (roomA.y <= roomB.y && roomA.y + roomA.height >= roomB.y + roomB.height);
          
        if (verticalOverlap) {
          result[i] = {
            ...roomA,
            x: roomB.x + roomB.width
          };
        }
      }
      
      // Bottom edge of roomA close to top edge of roomB
      if (Math.abs((roomA.y + roomA.height) - roomB.y) < threshold) {
        // Check if they overlap horizontally
        const horizontalOverlap = 
          (roomA.x <= roomB.x + roomB.width && roomA.x >= roomB.x) ||
          (roomA.x + roomA.width >= roomB.x && roomA.x + roomA.width <= roomB.x + roomB.width) ||
          (roomA.x <= roomB.x && roomA.x + roomA.width >= roomB.x + roomB.width);
          
        if (horizontalOverlap) {
          result[i] = {
            ...roomA,
            y: roomB.y - roomA.height
          };
        }
      }
      
      // Top edge of roomA close to bottom edge of roomB
      if (Math.abs(roomA.y - (roomB.y + roomB.height)) < threshold) {
        // Check if they overlap horizontally
        const horizontalOverlap = 
          (roomA.x <= roomB.x + roomB.width && roomA.x >= roomB.x) ||
          (roomA.x + roomA.width >= roomB.x && roomA.x + roomA.width <= roomB.x + roomB.width) ||
          (roomA.x <= roomB.x && roomA.x + roomA.width >= roomB.x + roomB.width);
          
        if (horizontalOverlap) {
          result[i] = {
            ...roomA,
            y: roomB.y + roomB.height
          };
        }
      }
    }
  }
  
  return result;
}

// Distribute rooms evenly (horizontally or vertically)
export function distributeRooms(rooms: Room[], direction: 'horizontal' | 'vertical'): Room[] {
  if (rooms.length <= 2) return rooms;
  
  const result = [...rooms];
  
  if (direction === 'horizontal') {
    // Sort rooms by x position
    result.sort((a, b) => a.x - b.x);
    
    const leftMost = result[0];
    const rightMost = result[result.length - 1];
    const totalWidth = (rightMost.x + rightMost.width) - leftMost.x;
    
    const spacing = totalWidth / (result.length - 1);
    
    for (let i = 1; i < result.length - 1; i++) {
      result[i] = {
        ...result[i],
        x: leftMost.x + (spacing * i)
      };
    }
  } else {
    // Sort rooms by y position
    result.sort((a, b) => a.y - b.y);
    
    const topMost = result[0];
    const bottomMost = result[result.length - 1];
    const totalHeight = (bottomMost.y + bottomMost.height) - topMost.y;
    
    const spacing = totalHeight / (result.length - 1);
    
    for (let i = 1; i < result.length - 1; i++) {
      result[i] = {
        ...result[i],
        y: topMost.y + (spacing * i)
      };
    }
  }
  
  return result;
}

// Center a room in the viewport
export function centerRoomInViewport(room: Room, viewportWidth: number, viewportHeight: number): Room {
  return {
    ...room,
    x: (viewportWidth / 2) - (room.width / 2),
    y: (viewportHeight / 2) - (room.height / 2)
  };
}

// Mirror a room horizontally or vertically
export function mirrorRoom(room: Room, direction: 'horizontal' | 'vertical'): Room {
  if (direction === 'horizontal') {
    // For horizontal mirroring, we'd mirror the objects only
    // The room shape stays the same
    if (!room.objects || room.objects.length === 0) return room;
    
    const mirrored = {
      ...room,
      objects: room.objects.map(obj => {
        let newWallSide = obj.wallSide;
        let newPosition = obj.position;
        
        if (obj.wallSide === 'left') {
          newWallSide = 'right';
        } else if (obj.wallSide === 'right') {
          newWallSide = 'left';
        }
        
        if (obj.wallSide === 'top' || obj.wallSide === 'bottom') {
          // Invert the position along the wall
          newPosition = 100 - obj.position;
        }
        
        return {
          ...obj,
          wallSide: newWallSide as WallSide,
          position: newPosition
        };
      })
    };
    
    return mirrored;
  } else {
    // For vertical mirroring, we'd mirror the objects only
    // The room shape stays the same
    if (!room.objects || room.objects.length === 0) return room;
    
    const mirrored = {
      ...room,
      objects: room.objects.map(obj => {
        let newWallSide = obj.wallSide;
        let newPosition = obj.position;
        
        if (obj.wallSide === 'top') {
          newWallSide = 'bottom';
        } else if (obj.wallSide === 'bottom') {
          newWallSide = 'top';
        }
        
        if (obj.wallSide === 'left' || obj.wallSide === 'right') {
          // Invert the position along the wall
          newPosition = 100 - obj.position;
        }
        
        return {
          ...obj,
          wallSide: newWallSide as WallSide,
          position: newPosition
        };
      })
    };
    
    return mirrored;
  }
}